text-decoration:none;
margin-left:25px;
}

.hero{
height:90vh;
display:flex;
justify-content:center;
align-items:center;
text-align:center;
padding:20px;
background:linear-gradient(135deg,#000,#111,#1a1a1a);
}

.hero h1{
font-size:60px;
margin-bottom:20px;
}

.hero p{
font-size:22px;
margin-bottom:30px;
color:#bbb;
}

.button{
display:inline-block;
padding:15px 35px;
background:#00d4ff;
color:black;
font-weight:bold;
text-decoration:none;
border-radius:40px;
}

section{
padding:80px 10%;
}

.cards{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:25px;
}

.card{
background:#181818;
padding:30px;
border-radius:15px;
}

.card h3{
margin-bottom:15px;

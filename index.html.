<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Poppins,sans-serif;
}

body{
background:#0d0d0d;
color:white;
}

header{
padding:25px 8%;
display:flex;
justify-content:space-between;
align-items:center;
background:black;
position:sticky;
